<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ptit.uno.client.view.fx.game.SpectatorUIBridge"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="table-background"
            stylesheets="@../css/game_board.css">

    <!-- 1. TOP: KHU VỰC NGƯỜI CHƠI 1 (CHỦ PHÒNG) -->
    <top>
        <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="8.0" bottom="4.0" left="15.0" right="15.0"/>
            </padding>
            
            <Label text="CHẾ ĐỘ KHÁN GIẢ - THEO DÕI TRẬN ĐẤU" styleClass="game-title" style="-fx-font-size: 16px;"/>

            <!-- Khung Host & Bài của Host -->
            <HBox alignment="CENTER" spacing="15.0">
                <!-- Thông tin Host -->
                <VBox alignment="CENTER" spacing="2.0">
                    <StackPane>
                        <Circle radius="22.0" fill="#e67e22"/>
                        <Label text="🦊" style="-fx-font-size: 18px;"/>
                    </StackPane>
                    <Label fx:id="lblHostName" text="HostName" styleClass="player-name" style="-fx-font-size: 12px;"/>
                    <Label fx:id="lblHostStatus" text="Đang chờ" styleClass="player-status-waiting"/>
                </VBox>

                <!-- Dãy bài của Host (Ngửa) -->
                <ScrollPane vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true"
                            prefHeight="110.0" minWidth="650.0" maxWidth="820.0" style="-fx-background-color: transparent;">
                    <HBox fx:id="hostHandBox" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 5px;"/>
                </ScrollPane>
            </HBox>
        </VBox>
    </top>

    <!-- 2. LEFT: KHUNG GAME LOG -->
    <left>
        <VBox alignment="TOP_LEFT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets top="10.0" bottom="10.0" left="15.0" right="0.0"/>
            </padding>

            <VBox styleClass="gamelog-container" VBox.vgrow="ALWAYS" maxHeight="450.0" spacing="6.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="GAME LOG" styleClass="gamelog-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="›" styleClass="gamelog-header-title" style="-fx-cursor: hand; -fx-font-size: 14px;"/>
                </HBox>
                <ListView fx:id="gameLogListView" styleClass="gamelog-message-list" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </left>

    <!-- 3. CENTER: BÀN CHƠI CHÍNH (CỌC BÀI, LƯỢT CHƠI) -->
    <center>
        <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
            
            <!-- Khu vực 2 cọc bài giữa bàn -->
            <HBox alignment="CENTER" spacing="30.0">
                <VBox alignment="CENTER" spacing="4.0">
                    <StackPane styleClass="center-pile">
                        <ImageView fx:id="drawPileImageView" fitWidth="100.0" fitHeight="150.0" preserveRatio="true"/>
                    </StackPane>
                </VBox>

                <VBox alignment="CENTER" spacing="4.0">
                    <StackPane styleClass="center-pile">
                        <ImageView fx:id="discardPileImageView" fitWidth="100.0" fitHeight="150.0" preserveRatio="true"/>
                    </StackPane>
                </VBox>
            </HBox>

            <!-- Lượt chơi & Đồng hồ đếm ngược -->
            <HBox alignment="CENTER" spacing="10.0" styleClass="turn-timer-pill" style="-fx-padding: 8px 20px;">
                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="⏱" style="-fx-font-size: 14px; -fx-text-fill: #f1c40f;"/>
                    <Label fx:id="lblCountdown" text="15s" styleClass="turn-timer-text" style="-fx-font-size: 16px;"/>
                </HBox>
                <Separator orientation="VERTICAL" style="-fx-opacity: 0.3; -fx-pref-height: 14px;"/>
                <HBox alignment="CENTER" spacing="6.0">
                    <Circle fx:id="turnIndicatorDot" radius="5.0" fill="#2ecc71"/>
                    <Label fx:id="lblTurnInfo" text="Lượt: Đang đợi..." styleClass="turn-info-text" style="-fx-font-size: 15px;"/>
                </HBox>
            </HBox>
        </VBox>
    </center>

    <!-- 4. RIGHT: NÚT THOÁT & KHUNG CHAT -->
    <right>
        <VBox alignment="TOP_RIGHT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_RIGHT">
            <padding>
                <Insets top="10.0" bottom="10.0" left="0.0" right="15.0"/>
            </padding>

            <!-- Nút Thoát -->
            <HBox alignment="CENTER_RIGHT" spacing="6.0">
                <Button fx:id="btnLeave" text="🚪 Rời phòng xem" styleClass="btn-utility" style="-fx-background-color: #e5383b;" onAction="#handleLeave"/>
            </HBox>

            <!-- Khung Chat -->
            <VBox styleClass="chat-container" VBox.vgrow="ALWAYS" maxHeight="450.0" spacing="6.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Chat" styleClass="chat-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="↗" styleClass="chat-header-title" style="-fx-cursor: hand;"/>
                </HBox>
                <ListView fx:id="chatListView" styleClass="chat-message-list" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="4.0">
                    <TextField fx:id="txtChatInput" promptText="Chat" styleClass="chat-input" HBox.hgrow="ALWAYS" onAction="#handleSendMessage"/>
                    <Button fx:id="btnSendChat" text="➤" styleClass="chat-btn-send" onAction="#handleSendMessage"/>
                </HBox>
            </VBox>
        </VBox>
    </right>

    <!-- 5. BOTTOM: KHU VỰC NGƯỜI CHƠI 2 (KHÁCH) -->
    <bottom>
        <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0.0" bottom="12.0" left="15.0" right="15.0"/>
            </padding>

            <HBox alignment="CENTER" spacing="15.0">
                <!-- Thông tin Guest -->
                <VBox alignment="CENTER" spacing="2.0">
                    <StackPane>
                        <Circle radius="22.0" fill="#2980b9"/>
                        <Label text="🐯" style="-fx-font-size: 18px;"/>
                    </StackPane>
                    <Label fx:id="lblGuestName" text="GuestName" styleClass="player-name" style="-fx-font-size: 12px;"/>
                    <Label fx:id="lblGuestStatus" text="Đang chờ" styleClass="player-status-waiting"/>
                </VBox>

                <!-- Dãy bài của Guest (Ngửa) -->
                <ScrollPane vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true"
                            prefHeight="110.0" minWidth="650.0" maxWidth="820.0" style="-fx-background-color: transparent;">
                    <HBox fx:id="guestHandBox" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 5px;"/>
                </ScrollPane>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
