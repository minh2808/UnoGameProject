<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ptit.uno.client.view.fx.game.SpectatorUIBridge"
           prefWidth="1150.0" prefHeight="680.0"
           styleClass="table-background"
           stylesheets="@../css/game_board.css">

    <!-- 1. BÀN CHƠI KHÁN GIẢ (BORDERPANE CHUẨN ĐỒNG NHẤT 100% VỚI GAME_BOARD.FXML) -->
    <BorderPane fx:id="mainBoardPane">

        <!-- TOP: TIÊU ĐỀ & KHU VỰC NGƯỜI CHƠI 1 (CHỦ PHÒNG / HOST) -->
        <top>
            <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="8.0" bottom="4.0" left="15.0" right="15.0"/>
                </padding>
                
                <!-- Tiêu đề chế độ xem trận -->
                <Label text="CHẾ ĐỘ XEM TRẬN ĐẤU (KHÁN GIẢ)" styleClass="game-title"/>

                <!-- Khung Chủ phòng & Dãy bài căn giữa -->
                <HBox alignment="CENTER" spacing="18.0">
                    <!-- Thông tin Chủ phòng (Host) -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="player-badge" style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 30; -fx-padding: 5 15 5 8;">
                        <FontIcon iconLiteral="fas-user-shield" iconSize="36" iconColor="#e67e22"/>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <Label fx:id="lblHostName" text="Chủ phòng" styleClass="player-name"/>
                            <HBox spacing="8.0">
                                <Label fx:id="lblHostCards" text="0 lá" styleClass="player-subtext"/>
                                <Label fx:id="lblHostStatus" text="Đang chờ" styleClass="player-status-waiting"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Dãy bài của Host (Ngửa cho khán giả quan sát) -->
                    <ScrollPane vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true"
                                prefHeight="125.0" minWidth="600.0" maxWidth="780.0" style="-fx-background-color: transparent;">
                        <HBox fx:id="hostHandBox" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 5px;"/>
                    </ScrollPane>
                </HBox>
            </VBox>
        </top>

        <!-- LEFT: KHOẢNG TRỐNG VÔ HÌNH 220PX CÂN BẰNG ĐỐI XỨNG 100% VỚI KHUNG CHAT PHẢI -->
        <left>
            <Region prefWidth="220.0" mouseTransparent="true">
                <BorderPane.margin>
                    <Insets left="15.0"/>
                </BorderPane.margin>
            </Region>
        </left>

        <!-- CENTER: BÀN CHƠI CHÍNH (CỌC BÀI, CHỌN MÀU, NÚT UNO) -->
        <center>
            <HBox alignment="CENTER" spacing="25.0" BorderPane.alignment="CENTER" fillHeight="false">

                <!-- Cột trái: Spacer cân bằng tuyệt đối với cụm chỉ báo màu bên phải -->
                <Region minWidth="65.0" prefWidth="65.0" maxWidth="65.0" />

                <!-- Khu vực Giữa (Đồng hồ đếm ngược + Cọc bài) -->
                <VBox alignment="CENTER" spacing="15.0">
                    <!-- VIÊN THUỐC THÔNG BÁO LƯỢT CHƠI & ĐỒNG HỒ ĐẾM NGƯỢC -->
                    <HBox fx:id="turnIndicatorBox" alignment="CENTER" spacing="12.0" styleClass="turn-timer-pill">
                        <!-- Đồng hồ đếm ngược -->
                        <HBox alignment="CENTER" spacing="6.0">
                            <FontIcon iconLiteral="fas-clock" iconSize="18" iconColor="#f1c40f"/>
                            <Label fx:id="lblCountdown" text="15s" styleClass="turn-timer-text" style="-fx-font-size: 16px; -fx-font-family: monospace;"/>
                        </HBox>

                        <Separator orientation="VERTICAL" style="-fx-opacity: 0.35; -fx-pref-height: 18px;"/>

                        <!-- Đèn báo và thông tin lượt đi -->
                        <HBox alignment="CENTER" spacing="8.0">
                            <Circle fx:id="turnIndicatorDot" radius="6.0" fill="#2ecc71"/>
                            <Label fx:id="lblTurnInfo" text="Lượt: Đang tải..." styleClass="turn-info-text" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </HBox>
                    </HBox>

                    <!-- Khung chứa 2 cọc bài (Viền xanh phát sáng piles-wrapper) -->
                    <HBox alignment="CENTER" spacing="8.0" styleClass="piles-wrapper" fillHeight="false">
                        <!-- Cọc bài rút (úp) -->
                        <StackPane fx:id="drawPileContainer" styleClass="center-pile">
                            <ImageView fx:id="drawPileImageView" fitWidth="120.0" fitHeight="180.0" preserveRatio="true"/>
                        </StackPane>

                        <!-- Lá bài ngửa trên cùng của cọc bỏ -->
                        <StackPane fx:id="discardPileContainer" styleClass="center-pile">
                            <ImageView fx:id="discardPileImageView" fitWidth="120.0" fitHeight="180.0" preserveRatio="true"/>
                        </StackPane>
                    </HBox>
                </VBox>

                <!-- Cụm hình thoi bên phải (Màu hiện tại & Biểu tượng UNO) -->
                <VBox alignment="CENTER" spacing="15.0" minWidth="65.0" prefWidth="65.0" maxWidth="65.0">
                    <!-- Hình thoi màu hiện tại -->
                    <ImageView fx:id="currentColorIndicator" fitWidth="65.0" fitHeight="65.0" preserveRatio="true">
                        <image>
                            <Image url="@../sprites/colors.png"/>
                        </image>
                    </ImageView>

                    <!-- Biểu tượng UNO (Ảnh but_uno.png sáng lên khi có người hô UNO) -->
                    <ImageView fx:id="unoBadge" fitWidth="65.0" fitHeight="65.0" preserveRatio="true" style="-fx-opacity: 0.45;">
                        <image>
                            <Image url="@../sprites/but_uno.png"/>
                        </image>
                    </ImageView>
                </VBox>

            </HBox>
        </center>

        <!-- RIGHT: CÁC NÚT PHỤ & KHUNG CHAT (ĐỒNG NHẤT 100% VỚI GAME_BOARD.FXML) -->
        <right>
            <VBox alignment="TOP_RIGHT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_RIGHT">
                <padding>
                    <Insets top="0.0" bottom="10.0" left="0.0" right="15.0"/>
                </padding>

                <!-- Nút Rời phòng xem -->
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Button fx:id="btnLeave" text="Rời phòng xem" styleClass="btn-utility" onAction="#handleLeave">
                        <graphic>
                            <FontIcon iconLiteral="fas-sign-out-alt" iconSize="12" iconColor="#b3c2b8" mouseTransparent="true"/>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Khung Chat phòng đấu (Chỉ đọc đối với Khán giả) -->
                <VBox styleClass="chat-container" VBox.vgrow="ALWAYS" maxHeight="320.0" spacing="6.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Chat phòng đấu" styleClass="chat-header-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <FontIcon iconLiteral="fas-comments" iconSize="12" iconColor="#b3c2b8"/>
                    </HBox>
                    <ListView fx:id="chatListView" styleClass="chat-message-list" VBox.vgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="6.0" style="-fx-padding: 7 8 7 8; -fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 8;">
                        <FontIcon iconLiteral="fas-comment-slash" iconSize="12" iconColor="#95a5a6"/>
                        <Label text="Khán giả không thể bình luận" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px; -fx-font-style: italic;"/>
                    </HBox>
                </VBox>
            </VBox>
        </right>

        <!-- BOTTOM: KHU VỰC NGƯỜI CHƠI 2 (KHÁCH / GUEST) & BÀI TRÊN TAY -->
        <bottom>
            <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="0.0" bottom="12.0" left="15.0" right="15.0"/>
                </padding>

                <HBox alignment="CENTER" spacing="18.0">
                    <!-- Avatar & Trạng thái Người chơi 2 (Guest) -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="player-badge" style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 30; -fx-padding: 5 15 5 8;">
                        <FontIcon iconLiteral="fas-user-circle" iconSize="42" iconColor="#3498db" />
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <Label fx:id="lblGuestName" text="Khách" styleClass="player-name" style="-fx-font-size: 14px;"/>
                            <HBox spacing="8.0">
                                <Label fx:id="lblGuestCards" text="0 lá" styleClass="player-subtext"/>
                                <Label fx:id="lblGuestStatus" text="Đang chờ" styleClass="player-status-waiting"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Dãy bài trên tay Guest (Ngửa cho khán giả quan sát) -->
                    <ScrollPane vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true"
                                prefHeight="135.0" minWidth="600.0" maxWidth="780.0" style="-fx-background-color: transparent;">
                        <HBox fx:id="guestHandBox" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 10px 5px;"/>
                    </ScrollPane>
                </HBox>
            </VBox>
        </bottom>

    </BorderPane>

    <!-- 2. LỚP OVERLAY CHUYỂN ĐỘNG CHO ANIMATION BÀI BAY & HIỆU ỨNG TỰ DO (ĐỒNG NHẤT VỚI GAME_BOARD.FXML) -->
    <Pane fx:id="animationLayer" pickOnBounds="false" />

</StackPane>
