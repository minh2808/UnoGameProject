<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ptit.uno.client.view.fx.lobby.LobbyUIBridge"
            prefWidth="1140.0" prefHeight="700.0"
            styleClass="auth-root"
            stylesheets="@../css/uno_theme.css">

    <!-- 1. TOP BAR THÔNG TIN NGƯỜI DÙNG & TIỆN ÍCH -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="auth-card"
              style="-fx-padding: 10px 20px; -fx-background-color: #12151c; -fx-background-radius: 0; -fx-border-color: #2a303c; -fx-border-width: 0 0 1px 0;">
                
                <!-- WIDGET NGƯỜI DÙNG -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <!-- Avatar (Viền glow xanh) -->
                    <StackPane style="-fx-background-color: #4c8bf520; -fx-border-color: #4c8bf5; -fx-border-width: 1.5; -fx-border-radius: 50%; -fx-background-radius: 50%; -fx-min-width: 44; -fx-min-height: 44; -fx-max-width: 44; -fx-max-height: 44;">
                        <FontIcon iconLiteral="fas-user-astronaut" iconSize="22" iconColor="#4c8bf5"/>
                    </StackPane>
                    
                    <!-- Thông tin -->
                    <VBox spacing="4" alignment="CENTER_LEFT">
                        <Label fx:id="lblUsername" text="Đang tải..." style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <!-- ELO Badge -->
                            <HBox spacing="4" alignment="CENTER" style="-fx-background-color: #ff9f1c20; -fx-padding: 2 6; -fx-background-radius: 4;">
                                <FontIcon iconLiteral="fas-star" iconSize="10" iconColor="#ff9f1c"/>
                                <Label fx:id="lblElo" text="--- Elo" style="-fx-text-fill: #ff9f1c; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                            
                            <!-- WIN RATE Badge -->
                            <HBox spacing="4" alignment="CENTER" style="-fx-background-color: #4ff0a020; -fx-padding: 2 6; -fx-background-radius: 4;">
                                <FontIcon iconLiteral="fas-trophy" iconSize="10" iconColor="#4ff0a0"/>
                                <Label fx:id="lblWinRate" text="Thắng -/-" style="-fx-text-fill: #4ff0a0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                        </HBox>
                    </VBox>
                </HBox>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnLeaderboard" text="Bảng xếp hạng" styleClass="btn-ghost" style="-fx-text-fill: #b3bccf;">
                        <graphic>
                            <FontIcon iconLiteral="fas-crown" iconColor="#ff9f1c" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnHistory" text="Lịch sử đấu" styleClass="btn-ghost" style="-fx-text-fill: #b3bccf;">
                        <graphic>
                            <FontIcon iconLiteral="fas-history" iconColor="#4c8bf5" iconSize="14"/>
                        </graphic>
                    </Button>
                    <Button fx:id="btnLogout" text="Đăng xuất" styleClass="btn-danger">
                        <graphic>
                            <FontIcon iconLiteral="fas-sign-out-alt" iconColor="white" iconSize="14"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
    </top>

    <!-- 3. NỘI DUNG CHÍNH: CHIA 2 CỘT (PHÒNG CHƠI & ONLINE) -->
    <center>
        <HBox spacing="14.0">
            <padding>
                <Insets top="12.0" bottom="12.0" left="14.0" right="14.0"/>
            </padding>

            <!-- CỘT TRÁI: DANH SÁCH PHÒNG CHƠI -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <VBox styleClass="auth-card" spacing="12.0" VBox.vgrow="ALWAYS" style="-fx-padding: 14px; -fx-background-color: #12151c;">
                    <!-- HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Danh sách phòng" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: white;" />
                        <Label fx:id="lblRoomCount" text="0 phòng" minWidth="-Infinity" style="-fx-background-color: #2a303c; -fx-text-fill: #8c95a6; -fx-padding: 2 6; -fx-background-radius: 4; -fx-font-size: 11px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <!-- Search Box -->
                        <HBox fx:id="searchBoxContainer" alignment="CENTER_LEFT" spacing="6" styleClass="lobby-search-box">
                            <FontIcon iconLiteral="fas-search" iconSize="12" iconColor="#8c95a6"/>
                            <TextField fx:id="txtSearchRoom" promptText="Tìm phòng..." 
                                       styleClass="lobby-search-input" prefWidth="130" minWidth="85"/>
                        </HBox>
                        
                        <!-- Filter Toggle -->
                        <HBox styleClass="segmented-button-bar" minWidth="-Infinity">
                            <ToggleButton fx:id="tglFilterAll" text="Tất cả" selected="true" minWidth="-Infinity">
                                <toggleGroup>
                                    <ToggleGroup fx:id="filterGroup" />
                                </toggleGroup>
                            </ToggleButton>
                            <ToggleButton fx:id="tglFilterWaiting" text="Đang chờ" toggleGroup="$filterGroup" minWidth="-Infinity" />
                            <ToggleButton fx:id="tglFilterPlaying" text="Đang chơi" toggleGroup="$filterGroup" minWidth="-Infinity" />
                        </HBox>

                        <Button fx:id="btnRefreshGrid" styleClass="btn-ghost" style="-fx-padding: 4 8;" minWidth="-Infinity">
                            <graphic>
                                <FontIcon iconLiteral="fas-sync-alt" iconColor="#8c95a6"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- LƯỚI PHÒNG CHƠI -->
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-control-inner-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="fpRoomContainer" hgap="12" vgap="12" />
                    </ScrollPane>
                </VBox>

                <!-- NÚT TẠO PHÒNG -->
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="btnCreateRoom" text="➕ Tạo phòng mới" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 8 20;" />
                </HBox>
            </VBox>

            <!-- CỘT PHẢI: NGƯỜI CHƠI TRỰC TUYẾN -->
            <VBox styleClass="auth-card" spacing="10.0" prefWidth="290.0" minWidth="280.0" maxWidth="310.0" style="-fx-padding: 12px;">
                <Label text="NGƯỜI CHƠI TRỰC TUYẾN" styleClass="field-label, highlight-yellow"
                       style="-fx-font-size: 14.5px;"/>
                <TableView fx:id="tblOnline" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOnlineName" text="Tên người chơi" prefWidth="120.0"/>
                        <TableColumn fx:id="colOnlineElo" text="Elo" prefWidth="55.0"/>
                        <TableColumn fx:id="colOnlineStatus" text="Trạng thái" prefWidth="85.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- KHU VỰC 2 NÚT THAO TÁC Ở DƯỚI CÙNG -->
                <HBox spacing="8.0" alignment="CENTER">
                    <Button fx:id="btnQuickMatch" text="⚡ Ghép ngẫu nhiên" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="btn-quick-match" />
                    <Button fx:id="btnInviteSelected" text="✉ Mời bạn" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="btn-invite-selected" />
                </HBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>
