<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ptit.uno.client.view.fx.GameBoardController"
            prefWidth="1100.0" prefHeight="650.0"
            styleClass="table-background"
            stylesheets="@../css/game_board.css">

    <!-- 1. TOP: TIÊU ĐỀ & KHU VỰC ĐỐI THỦ + HUD -->
    <top>
        <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="8.0" bottom="4.0" left="15.0" right="15.0"/>
            </padding>
            
            <!-- Tiêu đề -->
            <Label text="TRÒ CHƠI UNO TRỰC TUYẾN" styleClass="game-title"/>

            <!-- Khung Đối thủ & Dãy bài căn giữa tuyệt đối, co giãn đều sang 2 bên -->
            <HBox alignment="CENTER" spacing="18.0">
                <!-- Thông tin Đối thủ -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="player-badge">
                    <StackPane>
                        <Circle fx:id="opponentAvatarCircle" radius="20.0" fill="#e67e22"/>
                        <Label text="🦊" style="-fx-font-size: 18px;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblOpponentName" text="Đối thủ" styleClass="player-name"/>
                        <HBox spacing="8.0">
                            <Label fx:id="lblOpponentCards" text="🂠 0 lá" styleClass="player-subtext"/>
                            <Label fx:id="lblOpponentStatus" text="Đang chờ" styleClass="player-status-waiting"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Dãy bài úp của đối thủ căn giữa, tự động mở rộng đều ra 2 bên khi thêm lá -->
                <HBox fx:id="opponentHandBox" alignment="CENTER" spacing="-28.0" prefHeight="80.0"/>
            </HBox>
        </VBox>
    </top>

    <!-- 2. LEFT: KHUNG GAME LOG (CÂN BẰNG VỚI KHUNG CHAT BÊN PHẢI ĐỂ CỌC BÀI Ở CHÍNH GIỮA BÀN ĐẤU) -->
    <left>
        <VBox alignment="TOP_LEFT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets top="0.0" bottom="10.0" left="15.0" right="0.0"/>
            </padding>

            <!-- Khoảng đệm đối xứng với nút Trợ giúp/Thoát bàn bên phải để chiều cao đều nhau -->
            <HBox alignment="CENTER_LEFT" spacing="6.0" prefHeight="26.0">
                <Label text="Lịch sử trận đấu" styleClass="chat-header-title" style="-fx-opacity: 0.6;"/>
            </HBox>

            <!-- Khung Game Log -->
            <VBox styleClass="gamelog-container" VBox.vgrow="ALWAYS" maxHeight="320.0" spacing="6.0">
                <!-- Tiêu đề Game Log -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="GAME LOG" styleClass="gamelog-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="›" styleClass="gamelog-header-title" style="-fx-cursor: hand; -fx-font-size: 14px;"/>
                </HBox>

                <!-- Danh sách các dòng Log sự kiện -->
                <ListView fx:id="gameLogListView" styleClass="gamelog-message-list" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </left>

    <!-- 3. CENTER: BÀN CHƠI CHÍNH (CỌC BÀI, LÁ ĐÁNH, NÚT ĐÁNH BÀI) -->
    <center>
        <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <!-- Khu vực 2 cọc bài giữa bàn -->
            <HBox alignment="CENTER" spacing="25.0">
                <!-- Cọc bài rút (úp) -->
                <VBox alignment="CENTER" spacing="4.0">
                    <StackPane fx:id="drawPileContainer" styleClass="center-pile" onMouseClicked="#handleDrawCard">
                        <ImageView fx:id="drawPileImageView" fitWidth="90.0" fitHeight="135.0" preserveRatio="true"/>
                    </StackPane>
                </VBox>

                <!-- Lá bài ngửa trên cùng của cọc bỏ -->
                <VBox alignment="CENTER" spacing="4.0">
                    <StackPane fx:id="discardPileContainer" styleClass="center-pile">
                        <ImageView fx:id="discardPileImageView" fitWidth="90.0" fitHeight="135.0" preserveRatio="true"/>
                    </StackPane>
                </VBox>
            </HBox>

            <!-- Cụm hiển thị Lượt chơi & Đồng hồ đếm ngược trung tâm bàn đấu -->
            <HBox alignment="CENTER" spacing="10.0" styleClass="turn-timer-pill">
                <HBox alignment="CENTER" spacing="5.0">
                    <Label text="⏱" style="-fx-font-size: 13px; -fx-text-fill: #f1c40f;"/>
                    <Label fx:id="lblCountdown" text="15s" styleClass="turn-timer-text"/>
                </HBox>
                <Separator orientation="VERTICAL" style="-fx-opacity: 0.3; -fx-pref-height: 12px;"/>
                <HBox alignment="CENTER" spacing="6.0">
                    <Circle fx:id="turnIndicatorDot" radius="4.0" fill="#2ecc71"/>
                    <Label fx:id="lblTurnInfo" text="Lượt: BẠN" styleClass="turn-info-text"/>
                </HBox>
            </HBox>

            <!-- Nút Đánh Bài -->
            <HBox alignment="CENTER">
                <Button fx:id="btnPlayCard" text="Đánh Bài" styleClass="btn-play-card" onAction="#handlePlayCard" disable="true"/>
            </HBox>
        </VBox>
    </center>

    <!-- 3. RIGHT: CÁC NÚT PHỤ & KHUNG CHAT -->
    <right>
        <VBox alignment="TOP_RIGHT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_RIGHT">
            <padding>
                <Insets top="0.0" bottom="10.0" left="0.0" right="15.0"/>
            </padding>

            <!-- Nút Trợ giúp & Thoát bàn -->
            <HBox alignment="CENTER_RIGHT" spacing="6.0">
                <Button fx:id="btnHelp" text="? Trợ giúp" styleClass="btn-utility" onAction="#handleHelp"/>
                <Button fx:id="btnLeave" text="Thoát bàn" styleClass="btn-utility" onAction="#handleLeave"/>
            </HBox>

            <!-- Khung Chat -->
            <VBox styleClass="chat-container" VBox.vgrow="ALWAYS" maxHeight="320.0" spacing="6.0">
                <!-- Tiêu đề Chat -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Chat" styleClass="chat-header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="↗" styleClass="chat-header-title" style="-fx-cursor: hand;"/>
                </HBox>

                <!-- Danh sách tin nhắn -->
                <ListView fx:id="chatListView" styleClass="chat-message-list" VBox.vgrow="ALWAYS"/>

                <!-- Ô nhập tin nhắn -->
                <HBox alignment="CENTER" spacing="4.0">
                    <TextField fx:id="txtChatInput" promptText="Chat" styleClass="chat-input" HBox.hgrow="ALWAYS" onAction="#handleSendMessage"/>
                    <Button fx:id="btnSendChat" text="➤" styleClass="chat-btn-send" onAction="#handleSendMessage"/>
                </HBox>
            </VBox>
        </VBox>
    </right>

    <!-- 4. BOTTOM: NÚT HÔ UNO, BÀI TRÊN TAY NGƯỜI CHƠI -->
    <bottom>
        <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0.0" bottom="12.0" left="15.0" right="15.0"/>
            </padding>

            <HBox alignment="CENTER" spacing="15.0">
                <!-- Nút HÔ UNO! & Avatar người chơi -->
                <VBox alignment="CENTER" spacing="8.0">
                    <Button fx:id="btnCallUno" text="HÔ UNO!" styleClass="btn-uno" onAction="#handleCallUno"/>
                    <VBox alignment="CENTER" spacing="2.0">
                        <StackPane>
                            <Circle fx:id="playerAvatarCircle" radius="22.0" fill="#2980b9"/>
                            <Label text="👤" style="-fx-font-size: 18px;"/>
                        </StackPane>
                        <Label fx:id="lblPlayerName" text="player1" styleClass="player-name" style="-fx-font-size: 12px;"/>
                    </VBox>
                </VBox>

                <!-- Dãy bài trên tay người chơi trong thanh cuộn ngang -->
                <ScrollPane fx:id="handScrollPane" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true"
                            prefHeight="130.0" minWidth="650.0" maxWidth="820.0" style="-fx-background-color: transparent;">
                    <HBox fx:id="handCardsBox" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 10px 5px;"/>
                </ScrollPane>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
