<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ptit.uno.client.view.fx.game.GameBoardUIBridge"
           prefWidth="1100.0" prefHeight="650.0"
           styleClass="table-background"
           stylesheets="@../css/game_board.css">

    <!-- 1. BÀN CHƠI CHÍNH (CẤU TRÚC BORDERPANE HIỆN TẠI) -->
    <BorderPane fx:id="mainBoardPane">

        <!-- TOP: TIÊU ĐỀ & KHU VỰC ĐỐI THỦ + HUD -->
        <top>
            <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="8.0" bottom="4.0" left="15.0" right="15.0"/>
                </padding>
                
                <!-- Tiêu đề -->
                <Label text="TRÒ CHƠI UNO TRỰC TUYẾN" styleClass="game-title"/>

                <!-- Khung Đối thủ & Dãy bài căn giữa tuyệt đối -->
                <HBox alignment="CENTER" spacing="18.0">
                    <!-- Thông tin Đối thủ -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="player-badge" style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 30; -fx-padding: 5 15 5 5;">
                        <FontIcon iconLiteral="fas-user-astronaut" iconSize="36" iconColor="#e67e22"/>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <Label fx:id="lblOpponentName" text="Đối thủ" styleClass="player-name"/>
                            <HBox spacing="8.0">
                                <Label fx:id="lblOpponentCards" text="🂠 0 lá" styleClass="player-subtext"/>
                                <Label fx:id="lblOpponentStatus" text="Đang chờ" styleClass="player-status-waiting"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Dãy bài úp của đối thủ căn giữa -->
                    <HBox fx:id="opponentHandBox" alignment="CENTER" spacing="-28.0" prefHeight="80.0"/>
                </HBox>
            </VBox>
        </top>

        <!-- LEFT: KHUNG GAME LOG -->
        <left>
            <VBox alignment="TOP_LEFT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_LEFT">
                <padding>
                    <Insets top="0.0" bottom="10.0" left="15.0" right="0.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="6.0" prefHeight="26.0">
                    <Label text="Lịch sử trận đấu" styleClass="chat-header-title" style="-fx-opacity: 0.6;"/>
                </HBox>

                <VBox styleClass="gamelog-container" VBox.vgrow="ALWAYS" maxHeight="320.0" spacing="6.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="GAME LOG" styleClass="gamelog-header-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="›" styleClass="gamelog-header-title" style="-fx-cursor: hand; -fx-font-size: 14px;"/>
                    </HBox>
                    <ListView fx:id="gameLogListView" styleClass="gamelog-message-list" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </left>

        <!-- CENTER: BÀN CHƠI CHÍNH (CỌC BÀI, NÚT ĐÁNH BÀI, NÚT UNO) -->
        <center>
            <HBox alignment="CENTER" spacing="25.0" BorderPane.alignment="CENTER" fillHeight="false">
                
                <!-- Nút Đánh Bài ở bên TRÁI -->
                <Button fx:id="btnPlayCard" text="ĐÁNH BÀI" styleClass="btn-play-card-side" onAction="#handlePlayCard" disable="true"/>

                <!-- Khu vực Giữa (Đồng hồ đếm ngược + Cọc bài) -->
                <VBox alignment="CENTER" spacing="15.0">
                    <!-- ĐỒNG HỒ ĐẾM NGƯỢC -->
                    <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 20; -fx-padding: 5 15;">
                        <FontIcon iconLiteral="fas-clock" iconSize="22" iconColor="#e74c3c"/>
                        <Label fx:id="lblTurnTimer" text="15s" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e74c3c; -fx-font-family: monospace;"/>
                    </HBox>

                    <!-- Khung chứa 2 cọc bài (Viền xanh phát sáng) -->
                    <HBox alignment="CENTER" spacing="6.0" styleClass="piles-wrapper" fillHeight="false">
                        <!-- Cọc bài rút (úp) -->
                        <StackPane fx:id="drawPileContainer" styleClass="center-pile" onMouseClicked="#handleDrawCard">
                            <ImageView fx:id="drawPileImageView" fitWidth="120.0" fitHeight="180.0" preserveRatio="true"/>
                        </StackPane>

                        <!-- Lá bài ngửa trên cùng của cọc bỏ -->
                        <StackPane fx:id="discardPileContainer" styleClass="center-pile">
                            <ImageView fx:id="discardPileImageView" fitWidth="120.0" fitHeight="180.0" preserveRatio="true"/>
                        </StackPane>
                    </HBox>
                </VBox>

                <!-- Cụm hình thoi bên phải (Màu hiện tại & Nút UNO) -->
                <VBox alignment="CENTER" spacing="15.0">
                    <!-- Hình thoi màu hiện tại -->
                    <ImageView fx:id="currentColorIndicator" fitWidth="65.0" fitHeight="65.0" preserveRatio="true">
                        <image>
                            <Image url="@../sprites/colors.png"/>
                        </image>
                    </ImageView>

                    <!-- Nút HÔ UNO! (hình thoi ảnh) -->
                    <Button fx:id="btnCallUno" styleClass="btn-uno-image" onAction="#handleCallUno">
                        <graphic>
                            <ImageView fitWidth="65.0" fitHeight="65.0" preserveRatio="true">
                                <image>
                                    <Image url="@../sprites/but_uno.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </VBox>

            </HBox>
        </center>

        <!-- RIGHT: CÁC NÚT PHỤ & KHUNG CHAT -->
        <right>
            <VBox alignment="TOP_RIGHT" spacing="8.0" prefWidth="220.0" BorderPane.alignment="TOP_RIGHT">
                <padding>
                    <Insets top="0.0" bottom="10.0" left="0.0" right="15.0"/>
                </padding>

                <!-- Nút Trợ giúp & Thoát bàn -->
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Button fx:id="btnHelp" text="? Trợ giúp" styleClass="btn-utility" onAction="#handleHelp"/>
                    <Button fx:id="btnLeave" text="Thoát bàn" styleClass="btn-utility" onAction="#handleLeave"/>
                </HBox>

                <!-- Khung Chat -->
                <VBox styleClass="chat-container" VBox.vgrow="ALWAYS" maxHeight="320.0" spacing="6.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Chat" styleClass="chat-header-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="↗" styleClass="chat-header-title" style="-fx-cursor: hand;"/>
                    </HBox>
                    <ListView fx:id="chatListView" styleClass="chat-message-list" VBox.vgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="4.0">
                        <TextField fx:id="txtChatInput" promptText="Nhập tin nhắn..." styleClass="chat-input" HBox.hgrow="ALWAYS" onAction="#handleSendMessage"/>
                        <Button fx:id="btnSendChat" text="➤" styleClass="chat-btn-send" onAction="#handleSendMessage"/>
                    </HBox>
                </VBox>
            </VBox>
        </right>

        <!-- BOTTOM: AVATAR NGƯỜI CHƠI & BÀI TRÊN TAY -->
        <bottom>
            <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="0.0" bottom="12.0" left="15.0" right="15.0"/>
                </padding>

                <HBox alignment="CENTER" spacing="25.0">
                    <!-- Avatar người chơi -->
                    <VBox alignment="CENTER" spacing="6.0">
                        <FontIcon iconLiteral="fas-user-circle" iconSize="52" iconColor="#3498db" />
                        <Label fx:id="lblPlayerName" text="player1" styleClass="player-name" style="-fx-font-size: 14px;"/>
                    </VBox>

                    <!-- Dãy bài trên tay người chơi trong thanh cuộn ngang -->
                    <ScrollPane fx:id="handScrollPane" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true"
                                prefHeight="135.0" minWidth="650.0" maxWidth="840.0" style="-fx-background-color: transparent;">
                        <HBox fx:id="handCardsBox" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 10px 5px;"/>
                    </ScrollPane>
                </HBox>
            </VBox>
        </bottom>

    </BorderPane>

    <!-- 2. LỚP OVERLAY CHUYÊN DỤNG CHO ANIMATION BÀI BAY & HIỆU ỨNG TỰ DO -->
    <Pane fx:id="animationLayer" pickOnBounds="false" />

</StackPane>
